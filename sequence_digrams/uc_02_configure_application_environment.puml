@startuml
title UC-02 - Configure Environment (client-owned draft and staged secrets) - future editor, not MVP fixture path
autonumber
hide footbox
actor Developer
boundary "Web UI" as UI
control "Environment Configuration\nAPI / Controller" as API
control "Environment Configuration Service" as Service
entity "Application Query /\nApplication Repository" as AppRepo
control "Resource Output Catalog /\nResource Definition Query" as ResourceCatalog
control "Workload Output Catalog" as WorkloadCatalog
control "Environment Configuration Validator" as Validator
collections "Secret Store /\nSecret Management Adapter" as SecretStore
entity "Environment Configuration Repository" as ConfigRepo

note over UI, Service
  ConfigurationDefinitionDraft is owned by Web UI. Each edit carries the whole
  draft and returns its replacement; Service retains no configurationDraft.
  After upload, UI holds only an opaque stagedSecretReference, never plaintext.
end note
Developer -> UI: Select environment
UI -> API: selectEnvironment(applicationId, environment)
API -> Service: selectEnvironment(applicationId, environment)
Service -> AppRepo: loadConfigurationRequirements(applicationId)
AppRepo --> Service: Requirements
Service -> ConfigRepo: findByApplicationAndEnvironment(applicationId, environment)
ConfigRepo --> Service: Existing references, if any
Service --> API: ConfigurationDefinitionDraft
API --> UI: Store draft locally

loop For each Environment Variable
  alt Direct
    UI -> API: setDirectConfigurationValue(configurationDraft, variable, value)
    API -> Service: setDirectConfigurationValue(configurationDraft, variable, value)
  else Resource Output
    UI -> API: requestResourceOutputs(resource)
    API -> Service: requestResourceOutputs(resource)
    Service -> ResourceCatalog: listValidOutputs(resource)
    ResourceCatalog --> Service: Valid outputs
    Service --> API: Valid outputs
    UI -> API: bindResourceOutput(configurationDraft, variable, resource, output)
    API -> Service: bindResourceOutput(configurationDraft, variable, resource, output)
  else Workload Output
    UI -> API: requestWorkloadOutputs(workload)
    API -> Service: requestWorkloadOutputs(workload)
    Service -> WorkloadCatalog: listValidPlanTimeOutputs(workload)
    WorkloadCatalog --> Service: Valid plan-time outputs
    Service --> API: Valid outputs
    UI -> API: bindWorkloadOutput(configurationDraft, variable, workload, output)
    API -> Service: bindWorkloadOutput(configurationDraft, variable, workload, output)
  end
  Service --> API: Updated ConfigurationDefinitionDraft
  API --> UI: Replace local draft
end

loop For each Secret
  alt Direct secret
    Developer -> UI: Enter secret value
    UI -> API: stageSecret(applicationId, environment, secretDefinitionId,\nsecretValue, idempotencyKey)
    API -> Service: stageSecret(...)
    Service -> SecretStore: stageSecret(..., ttl, idempotencyKey)
    SecretStore --> Service: opaque stagedSecretReference
    Service --> API: opaque stagedSecretReference
    API --> UI: Replace plaintext with opaque reference
    UI -> API: setDirectConfigurationValue(configurationDraft, secret, stagedSecretReference)
    API -> Service: setDirectConfigurationValue(configurationDraft, secret, stagedSecretReference)
  else Sensitive Resource Output
    UI -> API: requestResourceOutputs(resource)
    API -> Service: requestResourceOutputs(resource)
    Service -> ResourceCatalog: listValidSensitiveOutputs(resource)
    ResourceCatalog --> Service: Valid sensitive outputs
    Service --> API: Valid outputs
    UI -> API: bindResourceOutput(configurationDraft, secret, resource, output)
    API -> Service: bindResourceOutput(configurationDraft, secret, resource, output)
  end
  Service --> API: Updated ConfigurationDefinitionDraft
  API --> UI: Replace local draft
end

Developer -> UI: Save Configuration
UI -> API: saveEnvironmentConfiguration(configurationDraft)
API -> Service: saveEnvironmentConfiguration(configurationDraft)
Service -> Validator: validateEnvironmentConfiguration(configurationDraft)
alt Validation failed
  Validator --> Service: Errors
  Service -> SecretStore: revokeStagedSecrets(newlyStagedReferences) <<best effort, idempotent>>
  Service --> API: Validation errors
else Valid
  Validator --> Service: Valid
  Service -> ConfigRepo: save(configuration with opaque references) <<DB transaction>>
  alt DB save failed
    ConfigRepo --> Service: Rollback
    Service -> SecretStore: revokeStagedSecrets(newlyStagedReferences) <<compensation>>
    Service --> API: Save failed
  else DB committed
    ConfigRepo --> Service: Saved
    Service -> SecretStore: promoteStagedSecrets(newlyStagedReferences) <<idempotent retry>>
    SecretStore --> Service: Permanent references
    Service --> API: Configuration saved
    API --> UI: Show confirmation
  end
end
note over Service, SecretStore
  There is no distributed transaction. Stable idempotency keys, staging TTL,
  idempotent promote/revoke, retry and orphan reconciliation bound the window;
  validation or DB failure triggers compensation.
end note
@enduml
