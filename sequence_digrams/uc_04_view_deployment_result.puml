@startuml
title UC-04 - MVP read-only, revision-aware result
autonumber
hide footbox
actor Developer
boundary "Web UI / API client" as UI
control "Deployment Query API" as API
control "Deployment Query Service" as Query
entity "Deployment Repository" as Repo
entity "Resource Instance Repository" as Resources
participant "Go Argo CD Adapter" as CD
participant "Argo CD" as Argo
participant "Workload Status Provider" as Workloads
participant "Kubernetes" as K8s
control "Deployment Result Aggregator" as Aggregator
Developer -> UI: Select deployment
UI -> API: getDeploymentDetail(deploymentId)
API -> Query: getDeploymentDetail(deploymentId)
Query -> Repo: loadDetailWithSnapshot(deploymentId)
Repo --> Query: Lifecycle, immutable expected images/names, record, steps, guard
alt Resource identities exist
  Query -> Resources: getInfrastructureStatus(resourceIds)
  Resources --> Query: Status / durable references
else No resource yet
  Query -> Query: PENDING or NOT_AVAILABLE
end
alt deliveryReference exists
  Query -> CD: getCDStatus(application UID, expected artifact digest)
  CD -> Argo: read Application
  Argo --> CD: UID, spec source, observed revision, Sync/Health
  CD --> Query: Correlated result or unavailable
  alt Provider unavailable
    Query -> Query: PENDING (PROVIDER_UNAVAILABLE); no runtime query
  else Different UID / desired source
    Query -> Query: NOT_AVAILABLE (REPLACED / SUPERSEDED)
  else Source matches but observed revision differs / not synced
    Query -> Query: CD_SYNCED / APPLICATION_READY PENDING
  else Synced revision equals expected digest
    Query -> Workloads: getWorkloadStatus(target, snapshot expectations, deploymentId)
    Workloads -> K8s: Read exact Deployment/ReplicaSet/Pod identities
    K8s --> Workloads: Template annotation/images, generation, rollout counts
    Workloads --> Query: Verified expected revision readiness
    Query -> Workloads: getDeploymentEndpoints(target, snapshot Service names)
    Workloads --> Query: Expected endpoint
  end
else No delivery acknowledgment
  Query -> Query: PENDING while executing; NOT_AVAILABLE when terminal
end
Query -> Aggregator: aggregate(lifecycle, steps, expected/observed revisions, errors)
Aggregator --> Query: View-only CD_SYNCED / APPLICATION_READY with reason
Query --> API: Result
API --> UI: Render progress, images, readiness, recovery requirement
opt Failure detail
  UI -> API: getDeploymentFailureDetail(deploymentId)
  API -> Query: getDeploymentFailureDetail(deploymentId)
  Query -> Repo: loadFailureAndRecoveryState(deploymentId)
  Repo --> UI: Sanitized error + failed phase + recovery state
end
note over Query, Aggregator
  No writes. Provider unavailable is PENDING with reason.
  Old healthy replicas cannot make a new deployment Ready.
  Ready requires expected digest, template deployment-id, image digests,
  observedGeneration and completed replica rollout.
end note
@enduml
