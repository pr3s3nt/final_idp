@startuml
title UC-03 - Deploy Application (durable asynchronous execution)
autonumber
hide footbox
actor Developer
boundary "Web UI" as UI
control "Deployment API / Controller" as API
control "Deployment Orchestrator" as Orchestrator
entity "Application Repository" as AppRepo
entity "Environment Configuration Repository" as ConfigRepo
control "Deployment Graph Builder" as GraphBuilder
control "Resource Definition Resolver" as ResourceResolver
control "Infrastructure Planner" as Planner
entity "Resource Instance Repository" as ResourceRepo
entity "Deployment Repository" as DeploymentRepo
queue "Deployment Execution Job / Outbox" as JobStore
control "Deployment Worker" as Worker
control "Infrastructure Reconciler" as Reconciler
participant "Provisioner Adapter" as Provisioner <<interface>>
participant "Terraform/OpenTofu Runner" as IaCRunner
control "Resource Output Resolver / Collector" as ResourceOutputResolver
control "Workload Output Resolver" as WorkloadOutputResolver
control "Environment Configuration Resolver" as ConfigResolver
control "Resolved Specification Generator" as SpecGenerator
control "Manifest Generator / Score Renderer" as ManifestGenerator
participant "score-k8s" as ScoreK8s
control "Target Manifest Adapter" as TargetAdapter
control "Environment Configuration Materializer" as ConfigMaterializer
control "Secret Materializer" as SecretMaterializer
participant "CD Integration / CD Provider Interface" as CDIntegration <<interface>>
control "Concrete CD Provider" as CDProvider
participant "CD System" as CDSystem

note right of ResourceRepo
  findReusableInstances always starts from the exact active
  resource_instance_binding tuple. Owner columns are not a fallback;
  shared bindings must already be platform-authorized.
end note

Developer -> UI: Select environment, target, images and context
UI -> API: createDeployment(applicationId, environment, target, images, context)
API -> Orchestrator: createDeployment(...)
Orchestrator -> AppRepo: findById(applicationId)
AppRepo --> Orchestrator: Active definition plus retained identities
Orchestrator -> ConfigRepo: findByApplicationAndEnvironment(applicationId, environment)
ConfigRepo --> Orchestrator: Environment Configuration
Orchestrator -> Orchestrator: validateDeploymentInput(definition, configuration, images, context)
Orchestrator -> GraphBuilder: buildDeploymentGraph(definition, configuration, images, context)
GraphBuilder --> Orchestrator: DeploymentGraph
Orchestrator -> ResourceResolver: resolveResourceDefinitions(graph, context)
ResourceResolver --> Orchestrator: ResourceResolution[]
Orchestrator -> ResourceRepo: findReusableInstances(applicationId, environment,\nresourceRequirementIds, target, sharingPolicy)
ResourceRepo --> Orchestrator: Scope-safe current instances
Orchestrator -> Planner: planInfrastructureChanges(graph, resolutions, currentInstances)
Planner --> Orchestrator: InfrastructurePlan(items: InfrastructurePlanItem[])
Orchestrator -> Planner: loadInfrastructureOverrides(plan)
Planner --> Orchestrator: OverrideDefinition[]
Orchestrator -> Orchestrator: canonicalizePlan(plan, overrideDefinitions, "sha256-v1")\ncomputePlanFingerprint(canonicalBytes)
note right of Orchestrator
  Canonical schema contains application, environment, target and, per sorted item: requirement id,
  definition identity plus provisioner_reference, supported_contexts,
  default_parameters and allowed_overrides; action, owner/scope/sharing key,
  referenced instance id, resolved parameters, and sorted override schema.
  Canonical JSON normalizes numbers/units and omits timestamps/generated ids.
  Plan/items/definitions are transient; only fingerprint and algorithm persist.
end note
Orchestrator -> DeploymentRepo: persistDeployment(..., fingerprint, "sha256-v1",\nAWAITING_CONFIRMATION)
DeploymentRepo --> Orchestrator: Persisted
Orchestrator --> API: plan, override definitions, fingerprint
API --> UI: Display plan

Developer -> UI: Confirm with overrides
UI -> API: confirmDeployment(deploymentId, overrides, idempotencyKey)
API -> Orchestrator: confirmDeployment(deploymentId, overrides, idempotencyKey)
Orchestrator -> DeploymentRepo: findByIdWithPersistedInputs(deploymentId)
DeploymentRepo --> Orchestrator: Inputs and stored fingerprint
Orchestrator -> AppRepo: findById(applicationId)
AppRepo --> Orchestrator: Current definition
Orchestrator -> ConfigRepo: findById(environmentConfigurationId)
ConfigRepo --> Orchestrator: Current configuration
Orchestrator -> GraphBuilder: buildDeploymentGraph(...)
GraphBuilder --> Orchestrator: Rebuilt graph
Orchestrator -> ResourceResolver: resolveResourceDefinitions(graph, context)
ResourceResolver --> Orchestrator: Current resolutions
Orchestrator -> ResourceRepo: findReusableInstances(applicationId, environment,\nresourceRequirementIds, target, sharingPolicy)
ResourceRepo --> Orchestrator: Scope-safe instances
Orchestrator -> Planner: planInfrastructureChanges(...)
Planner --> Orchestrator: Rebuilt typed plan
Orchestrator -> Planner: loadInfrastructureOverrides(rebuiltPlan)
Planner --> Orchestrator: Current OverrideDefinition[]
Orchestrator -> Orchestrator: recompute fingerprint with stored algorithm
alt Fingerprint changed
  Orchestrator -> DeploymentRepo: compareAndSetPlanFingerprint(...)
  Orchestrator --> API: PLAN_CHANGED plus rebuilt plan
  API --> UI: Re-present plan; no job exists
else Fingerprint matches
  Orchestrator -> Planner: applyInfrastructureOverrides(rebuiltPlan, overrides)\nvalidate key/type/range/enum
  Planner --> Orchestrator: Validated override values
  Orchestrator -> DeploymentRepo: acceptConfirmationAndEnqueue(deploymentId,\nAWAITING_CONFIRMATION, QUEUED, three PENDING steps,\noverrides, idempotencyKey) <<atomic DB transaction>>
  DeploymentRepo -> JobStore: INSERT QUEUED job/outbox row\n(unique deployment and idempotency key)
  JobStore --> DeploymentRepo: Durable tracking id
  DeploymentRepo --> Orchestrator: Tracking id (same id on retry)
  Orchestrator --> API: 202 Accepted(deploymentId, trackingId)
  API --> UI: Display tracking
end

... asynchronous retryable execution ...
Worker -> JobStore: claimNextJob(lease) <<SKIP LOCKED / CAS>>
JobStore --> Worker: job(deploymentId, overrides, attempt)
Worker -> DeploymentRepo: markExecutionRunning(deploymentId, jobId)
Worker -> DeploymentRepo: findByIdWithPersistedInputs(deploymentId)
DeploymentRepo --> Worker: Persisted inputs
Worker -> AppRepo: findById(applicationId)
AppRepo --> Worker: Current definition
Worker -> ConfigRepo: findById(environmentConfigurationId)
ConfigRepo --> Worker: Current configuration
Worker -> GraphBuilder: buildDeploymentGraph(...)
GraphBuilder --> Worker: Rebuilt graph
Worker -> ResourceResolver: resolveResourceDefinitions(graph, context)
ResourceResolver --> Worker: Current resolutions
Worker -> ResourceRepo: findReusableInstances(applicationId, environment,\nresourceRequirementIds, target, sharingPolicy)
ResourceRepo --> Worker: Scope-safe instances
Worker -> Planner: planInfrastructureChanges(...)
Planner --> Worker: Rebuilt typed plan
Worker -> Planner: loadInfrastructureOverrides(rebuiltPlan)
Planner --> Worker: Current OverrideDefinition[]
Worker -> Worker: verify canonical fingerprint = acceptedPlanFingerprint
Worker -> Planner: applyInfrastructureOverrides(rebuiltPlan, storedOverrides)
Planner --> Worker: Final InfrastructurePlan
Worker -> DeploymentRepo: recordDeploymentStep(INFRASTRUCTURE_READY, RUNNING, ...)
Worker -> Reconciler: reconcileInfrastructure(finalPlan, deploymentId)
Reconciler -> Provisioner: reconcile(finalPlan, idempotencyKey per item)
Provisioner -> IaCRunner: apply infrastructure modules
IaCRunner --> Provisioner: Resource state and raw outputs
Provisioner --> Reconciler: Results
Reconciler -> ResourceRepo: saveResourceInstancesAndBindings(owner/consumer scope,\nrequirement, target, sharing policy, state)
ResourceRepo --> Reconciler: Resource instances
Reconciler --> Worker: Infrastructure references
Worker -> DeploymentRepo: recordDeploymentStep(INFRASTRUCTURE_READY, SUCCEEDED,\ninfrastructureReferences)

Worker -> ResourceOutputResolver: collectResourceOutputs(infrastructureReferences)
ResourceOutputResolver -> ResourceRepo: loadResourceOutputs(infrastructureReferences)
ResourceRepo --> ResourceOutputResolver: ResourceOutput[]
ResourceOutputResolver --> Worker: ResourceOutput[]
Worker -> WorkloadOutputResolver: resolvePlanTimeWorkloadOutputs(graph, context)
WorkloadOutputResolver --> Worker: WorkloadOutput[] (Service DNS/endpoint)
note right of WorkloadOutputResolver
  Only deterministic plan-time outputs from workload metadata, graph and target
  context are allowed. Runtime-only output from this deployment cannot feed
  the same deployment; circular references fail validation.
end note
Worker -> DeploymentRepo: recordDeploymentStep(CONFIGURATION_RESOLVED, RUNNING, ...)
Worker -> ConfigResolver: resolveEnvironmentConfiguration(configuration,\nresourceOutputs, workloadOutputs)
ConfigResolver --> Worker: Resolved configuration
Worker -> DeploymentRepo: recordDeploymentStep(CONFIGURATION_RESOLVED, SUCCEEDED, ...)

Worker -> DeploymentRepo: recordDeploymentStep(MANIFEST_GENERATED, RUNNING, ...)
Worker -> SpecGenerator: generateResolvedApplicationSpecification(...)
SpecGenerator --> Worker: Resolved specification
Worker -> ManifestGenerator: generateKubernetesManifest(resolvedSpecification)
ManifestGenerator -> ScoreK8s: render(resolvedSpecification)
ScoreK8s --> ManifestGenerator: Base manifest
ManifestGenerator --> Worker: Base manifest
Worker -> TargetAdapter: adaptManifestForTarget(baseManifest, target)
TargetAdapter --> Worker: Adapted manifest
Worker -> ConfigMaterializer: materializeEnvironmentConfiguration(...)
ConfigMaterializer --> Worker: Manifest with configuration
Worker -> SecretMaterializer: materializeSecretConfiguration(...)
SecretMaterializer --> Worker: Desired deployment state
Worker -> DeploymentRepo: recordDeploymentStep(MANIFEST_GENERATED, SUCCEEDED, ...)

Worker -> CDIntegration: publishDesiredDeploymentState(desiredState, deploymentId, publishIdempotencyKey)
CDIntegration -> CDProvider: publish(desiredState, idempotencyKey)
CDProvider -> CDSystem: synchronize(desiredState)
CDSystem --> CDProvider: Delivery reference and status
CDProvider --> CDIntegration: Delivery reference and status
CDIntegration --> Worker: Delivery reference and status
Worker -> DeploymentRepo: saveDeploymentRecord(deploymentId, infrastructureReferences,\ndeliveryReference, deliveryStatus, SUBMITTED)
Worker -> JobStore: completeJob(jobId)

note over Worker, JobStore
  Retry uses a lease, attempts/max_attempts and stable deployment/phase keys.
  Provider reconcile and CD publish are idempotent. Terminal failure persists
  lifecycle/job FAILED; an internal step is FAILED only for its own phase.
  CD failure uses delivery_status/error_summary, never a fourth step.
end note
@enduml
