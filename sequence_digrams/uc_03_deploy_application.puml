@startuml
title UC-03 - MVP deployment (Go / Terraform / Argo CD)
autonumber
hide footbox
actor Developer
boundary "Web UI / API client" as UI
control "Deployment API" as API
control "Deployment Orchestrator" as Orchestrator
entity "Application / Configuration Repositories" as SourceRepo
control "Snapshot Builder" as SnapshotBuilder
control "Deployment Graph Builder" as GraphBuilder
control "Resource Definition Resolver" as Catalog
control "Infrastructure Planner" as Planner
entity "Resource Instance Repository" as ResourceRepo
entity "Deployment Repository" as Repo
control "Secret Reference Adapter" as Secrets
control "Deployment Worker" as Worker
control "Infrastructure Reconciler" as Reconciler
participant "Go Provisioner Adapter" as Provisioner
participant "Terraform / durable state" as Terraform
control "Resource Output Collector" as Outputs
control "Workload Output Resolver" as WorkloadOutputs
control "Configuration Resolver" as ConfigResolver
control "Resolved Specification Generator" as Spec
control "Manifest Generator" as Renderer
participant "score-k8s" as Score
control "Target / Config / Secret Materializers" as Materializers
participant "Go Argo CD Adapter" as CD
participant "OCI Registry" as Registry
participant "Argo CD Application API" as Argo

group Prepare: C2
Developer -> UI: Select images, dev and kind-idp-mvp
UI -> API: createDeployment(applicationId, environment, target, images, context)
API -> Orchestrator: createDeployment(...)
Orchestrator -> SourceRepo: readConsistentSource() [REPEATABLE READ]
SourceRepo --> Orchestrator: Source topology/configuration
Orchestrator -> SnapshotBuilder: buildInputSnapshot(source, images, context)
SnapshotBuilder -> Registry: resolveImageDigest(repository, selectedTag) for each workload
Registry --> SnapshotBuilder: Immutable image digests
SnapshotBuilder --> Orchestrator: Source snapshot + image digests + input fingerprint
Orchestrator -> Secrets: validateReferences(snapshot.secretRefs)
Secrets --> Orchestrator: UID/key/immutable verified; no credentials returned
Orchestrator -> GraphBuilder: buildDeploymentGraph(snapshot)
GraphBuilder --> Orchestrator: Graph
Orchestrator -> Catalog: resolveResourceDefinitions(graph, context)
Catalog --> Orchestrator: Current definition fields
Orchestrator -> ResourceRepo: findScopedInstances(exact active tuple)
ResourceRepo --> Orchestrator: ALL statuses, versions, state references
Orchestrator -> Planner: planInfrastructureChanges(snapshot, definitions, instances)
Planner --> Orchestrator: CREATE / REUSE plan and sha256-mvp-v1 fingerprint
note right of Planner
  Non-ready instances require recovery, except recovery-approved
  PLANNED which uses CREATE on the retained identity.
  No UPDATE or non-empty overrides in MVP.
end note
Orchestrator -> Repo: persistPreparedDeployment(snapshot, images, context, fingerprint)
note right of Repo
  One transaction, AWAITING_CONFIRMATION.
  No job or provider side effect.
end note
Repo --> API: deploymentId, snapshot/plan fingerprints and plan
API --> UI: Review plan
end

group Confirm: C3
UI -> API: confirmDeployment(deploymentId, expectedPlanFingerprint, {}, idempotencyKey)
API -> Orchestrator: confirmDeployment(...)
Orchestrator -> Repo: findAcceptedRequest(deploymentId, key, requestFingerprint)
alt Existing same key and payload
  Repo --> API: Existing trackingId (any lifecycle)
  API --> UI: 202 same trackingId
else Existing conflicting key or payload
  Repo --> API: ALREADY_ACCEPTED / IDEMPOTENCY_KEY_REUSED
  API --> UI: 409 conflict
else No accepted request
  Orchestrator -> Repo: lockDeploymentThenScope(deploymentId)
  note right of Repo
    Re-read accepted key/hash under Deployment lock before status/scope checks.
    A concurrent winner returns the existing result, not a second acceptance.
  end note
  break Concurrent accepted result / scope busy / recovery required
    Repo --> API: Existing tracking result or explicit 409 conflict
    API --> UI: Return without execution
  end
  Repo --> Orchestrator: Immutable snapshot, stored fingerprint, free guard
  Orchestrator -> GraphBuilder: buildDeploymentGraph(snapshot)
  Orchestrator -> Catalog: resolveResourceDefinitions(graph, context)
  Orchestrator -> ResourceRepo: findScopedInstances(exact active tuple)
  Orchestrator -> Planner: rebuildPlanAndFingerprint(snapshot, current catalog, instances)
  Planner --> Orchestrator: Rebuilt plan/fingerprint
  alt Expected != stored OR expected != rebuilt
    Orchestrator -> Repo: refreshAwaitingFingerprint(rebuilt)
    Orchestrator --> UI: 409 PLAN_CHANGED + plan/token; no job
  else All fingerprints match
    Orchestrator -> Secrets: validateReferences(snapshot.secretRefs)
    Orchestrator -> Repo: acceptConfirmationAndEnqueue(expected status + fingerprint, requestHash)
    note right of Repo
      ONE transaction: scope EXECUTING, Deployment/Record QUEUED,
      exactly three PENDING steps, one QUEUED job.
      Busy/recovery scope rejects; unique job handles concurrent retry.
    end note
    Repo --> API: trackingId after commit
    API --> UI: 202 Accepted
  end
end
end

... asynchronous execution; one worker run, no replay ...

group Worker precheck: C4
Worker -> Worker: acquireExclusiveHostLock() / old process group stopped
Worker -> Repo: claimQueuedJob(workerRunId)
Repo --> Worker: Immutable snapshot, accepted fingerprint
note right of Repo
  Atomic CLAIMED + RUNNING lifecycle/record +
  INFRASTRUCTURE_READY RUNNING.
  Every write requires matching workerRunId.
end note
Worker -> Secrets: validateReferences(snapshot.secretRefs)
Worker -> GraphBuilder: buildDeploymentGraph(snapshot)
Worker -> Catalog: resolveResourceDefinitions(graph, context)
Worker -> ResourceRepo: findScopedInstances(exact active tuple)
Worker -> Planner: rebuildPlanAndFingerprint(snapshot, definitions, instances)
Planner --> Worker: Final transient plan
break Stale/invalid preflight
  Worker -> Repo: failExecution(PLAN_STALE_AFTER_ACCEPT, no side effect)
  note right of Repo: FAILED + failed/skipped steps + guard IDLE, one transaction
end
end

group Infrastructure: C5
Worker -> Reconciler: reconcileInfrastructure(plan, deploymentId, workerRunId)
Reconciler -> Repo: reserveResourceAndAssociateRecord(scope, stable state path)
note right of Repo
  Before apply: PLANNED instance/OWNER binding/record association,
  then PROVISIONING and recovery_verified=false.
  REUSE retains identity and inspects existing provider objects.
end note
Reconciler -> Provisioner: reconcileOrInspect(scope, durable state reference)
Provisioner -> Terraform: apply CREATE / inspect REUSE (state lock)
Terraform --> Provisioner: Actual owned resource/state
Provisioner --> Reconciler: Durable identity and result
Reconciler -> ResourceRepo: checkpointReady(fingerprints, version, reference)
break Provider drift/error/uncertain outcome
  Worker -> Repo: failExecution(error, RECOVERY_REQUIRED)
end
Reconciler --> Worker: Resource references
Worker -> Repo: finishInfrastructureAndStartConfiguration()
end

group Configuration: C6
Worker -> Outputs: collectResourceOutputs(references)
Outputs -> Provisioner: readOutputsFromDurableState(references)
Provisioner --> Outputs: Non-sensitive host/port
Outputs --> Worker: Resource outputs
Worker -> WorkloadOutputs: resolvePlanTimeWorkloadOutputs(snapshot naming policy)
WorkloadOutputs --> Worker: Backend Service URL
Worker -> ConfigResolver: resolveEnvironmentConfiguration(snapshot, outputs, secretRefs)
ConfigResolver --> Worker: Transient resolved configuration
break Output collection/resolution error
  Worker -> Repo: failExecution(CONFIGURATION error, safe guard release)
end
Worker -> Repo: finishConfigurationAndStartManifest()
end

group Manifest: C7
Worker -> Spec: generateResolvedApplicationSpecification(snapshot, configuration)
Spec --> Worker: Resolved specification
Worker -> Renderer: generateKubernetesManifest(spec)
Renderer -> Score: render(spec)
Score --> Renderer: Base manifest
Renderer --> Worker: Base manifest
Worker -> Materializers: adaptAndMaterialize(snapshot names/digests, secretKeyRefs)
Materializers --> Worker: Desired state with deployment-id template annotation
break Render/materialization error
  Worker -> Repo: failExecution(MANIFEST error, safe guard release)
end
Worker -> Repo: finishManifestAndEnterPublish()
end

group Publish and atomic completion: C8-C10
Worker -> CD: publishDesiredDeploymentState(desiredState, deploymentId, workerRunId)
CD -> Registry: push deterministic OCI artifact
Registry --> CD: Artifact URI + digest
CD -> Repo: savePublicationIntent(uri, digest, expectedApplicationName)
CD -> Argo: upsertOwnedApplication(CAS, targetRevision=digest)
Argo --> CD: Application namespace/name/UID acknowledgment
break Definite rejection / missing acknowledgment
  Worker -> Repo: failExecution(PUBLISH, FAILED or UNKNOWN, recovery if uncertain)
end
CD --> Worker: Acknowledgment matching publication intent
Worker -> Repo: completeExecution(workerRunId, acknowledgment)
note right of Repo
  ONE transaction: delivery ack + SUBMITTED lifecycle/record,
  job SUCCEEDED/COMPLETE, guard IDLE.
  No independent completeJob commit.
end note
end
@enduml
