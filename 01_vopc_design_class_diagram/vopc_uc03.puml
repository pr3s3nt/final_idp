@startuml
title MVP VOPC - UC-03 and internal recovery
left to right direction
skinparam classAttributeIconSize 0
hide empty members
class "Web UI / API client" as UI <<boundary>>
class "Deployment API" as API <<control>> {
  +createDeployment(applicationId, environment, target, images, context)
  +confirmDeployment(deploymentId, expectedPlanFingerprint, overrides, idempotencyKey)
}
class "Deployment Orchestrator" as Orchestrator <<control>> {
  +createDeployment(...)
  +confirmDeployment(...)
}
class "Deployment Worker" as Worker <<control>> {
  +executeDeploymentJob(jobId)
}
class "Deployment Recovery Service" as Recovery <<control>> {
  +markInterruptedJobs(newWorkerRunId)
  +recoverDeployment(deploymentId, operator, evidence)
}
class "Application / Configuration Repositories" as Sources <<entity>> {
  +readConsistentSource()
}
class "Snapshot Builder" as Snapshot <<control>> {
  +buildInputSnapshot(source, images, context)
}
class "Deployment Graph Builder" as Graph <<control>> {
  +buildDeploymentGraph(snapshot)
}
class "Resource Definition Resolver" as Catalog <<control>> {
  +resolveResourceDefinitions(graph, context)
}
class "Infrastructure Planner" as Planner <<control>> {
  +planInfrastructureChanges(snapshot, definitions, instances)
  +rebuildPlanAndFingerprint(...)
}
class "Resource Instance Repository" as Resources <<entity>> {
  +findScopedInstances(exactActiveTuple)
  +checkpointReady(fingerprints, version, reference)
}
class "Deployment Repository" as Repo <<entity>> {
  +persistPreparedDeployment(snapshot, images, context, fingerprint)
  +findAcceptedRequest(deploymentId, key, requestFingerprint)
  +lockDeploymentThenScope(deploymentId)
  +acceptConfirmationAndEnqueue(...)
  +claimQueuedJob(workerRunId)
  +reserveResourceAndAssociateRecord(scope, statePath)
  +finishInfrastructureAndStartConfiguration()
  +finishConfigurationAndStartManifest()
  +finishManifestAndEnterPublish()
  +savePublicationIntent(uri, digest, expectedApplicationName)
  +completeExecution(deploymentId, workerRunId, acknowledgment)
  +failExecution(deploymentId, workerRunId, code, outcome)
  +markInterruptedJobs(newWorkerRunId)
  +commitVerifiedRecovery(operator, evidence)
}
interface "Secret Reference Adapter" as Secrets {
  +validateReferences(secretRefs)
}
class "Infrastructure Reconciler" as Reconciler <<control>> {
  +reconcileInfrastructure(plan, deploymentId, workerRunId)
}
interface "Go Provisioner Adapter" as Provisioner {
  +reconcileOrInspect(scope, durableStateReference)
  +readOutputsFromDurableState(references)
}
class "Terraform / durable state" as Terraform <<boundary>>
class "Resource Output Collector" as Outputs <<control>> {
  +collectResourceOutputs(references)
}
class "Workload Output Resolver" as WorkloadOutputs <<control>> {
  +resolvePlanTimeWorkloadOutputs(snapshot)
}
class "Configuration Resolver" as Config <<control>> {
  +resolveEnvironmentConfiguration(snapshot, outputs, secretRefs)
}
class "Resolved Specification Generator" as Spec <<control>> {
  +generateResolvedApplicationSpecification(snapshot, configuration)
}
class "Manifest Generator" as Renderer <<control>> {
  +generateKubernetesManifest(spec)
}
class "score-k8s" as Score <<boundary>>
class "Target / Config / Secret Materializers" as Materializers <<control>> {
  +adaptAndMaterialize(snapshot, configuration, secretKeyRefs)
}
class "Go Argo CD Adapter" as CD <<control>> {
  +publishDesiredDeploymentState(desiredState, deploymentId, workerRunId)
  +inspectPublicationIntent(expectedName, digest)
}
class "OCI Registry" as Registry <<boundary>>
class "Argo CD Application API" as Argo <<boundary>>
UI --> API
API --> Orchestrator
Orchestrator --> Sources
Orchestrator --> Snapshot
Snapshot --> Registry : resolve image tags to digests
Orchestrator --> Graph
Orchestrator --> Catalog
Orchestrator --> Planner
Orchestrator --> Resources
Orchestrator --> Secrets
Orchestrator --> Repo
Worker --> Repo
Worker --> Graph
Worker --> Catalog
Worker --> Planner
Worker --> Resources
Worker --> Secrets
Worker --> Reconciler
Worker --> Outputs
Worker --> WorkloadOutputs
Worker --> Config
Worker --> Spec
Worker --> Renderer
Worker --> Materializers
Worker --> CD
Reconciler --> Repo : atomic reservation
Reconciler --> Resources
Reconciler --> Provisioner
Outputs --> Provisioner : read durable state
Provisioner --> Terraform
Renderer --> Score
CD --> Registry
CD --> Repo : publication intent before Argo write
CD --> Argo
Recovery --> Repo
Recovery --> Resources
Recovery --> Provisioner
Recovery --> CD
note bottom of Repo
  All transactions listed in C2-C12; job/snapshot/guard are persistent
  objects, not a second database. No separate completeJob commit.
end note
@enduml
