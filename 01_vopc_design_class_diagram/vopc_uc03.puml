@startuml
title VOPC - UC-03 Deploy Application
left to right direction
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
hide empty members

package "Boundary/UI" {
  class "Web UI" as WebUI <<boundary>> {
    -selectedEnvironment: String
    -selectedTarget: String
    -selectedImages: Map
    +showDeploymentForm()
    +showInfrastructurePlan()
    +showDeploymentTracking()
  }
  class "Deployment API / Controller" as API <<control>> {
    +createDeployment(applicationId, environment, target, images, context)
    +confirmDeployment(deploymentId, overrides, idempotencyKey)
  }
}
package "Application services" {
  class "Deployment Orchestrator" as Orchestrator <<control>> {
    +createDeployment(applicationId, environment, target, images, context)
    +validateDeploymentInput(applicationDefinition, configuration, images, context)
    +canonicalizePlan(plan, overrideDefinitions, algo)
    +computePlanFingerprint(canonicalBytes)
    +confirmDeployment(deploymentId, overrides, idempotencyKey)
  }
  class "Deployment Worker" as Worker <<control>> {
    +executeDeploymentJob(jobId)
    +retryOrFail(jobId, error)
  }
}
package "Domain components" {
  class "Deployment Graph Builder" as GraphBuilder <<control>> {
    +buildDeploymentGraph(applicationDefinition, configuration, images, context)
  }
  class "Resource Definition Resolver" as ResourceResolver <<control>> {
    +resolveResourceDefinitions(graph, context)
  }
  class "Infrastructure Planner" as Planner <<control>> {
    +planInfrastructureChanges(graph, resolutions, scopedInstances)
    +loadInfrastructureOverrides(plan)
    +applyInfrastructureOverrides(plan, overrideValues)
  }
  class "Infrastructure Plan" as InfrastructurePlan <<transient>> {
    +applicationId: String
    +environment: String
    +deploymentTarget: String
    +items: InfrastructurePlanItem[]
  }
  class "Infrastructure Plan Item" as InfrastructurePlanItem <<transient>> {
    +resourceRequirementId: String
    +resourceDefinitionId: String
    +definitionPlanFields: Map
    +action: CREATE|UPDATE|REUSE
    +resolvedParameters: Map
    +ownershipScope: String
    +sharingKey: String
    +referencedResourceInstanceId: String
  }
  class "Override Definition" as OverrideDefinition <<transient>> {
    +parameterKey: String
    +valueType: String
    +required: Boolean
    +constraints: Map
  }
  class "Infrastructure Reconciler" as Reconciler <<control>> {
    +reconcileInfrastructure(finalPlan, deploymentId)
  }
  class "Resource Output Resolver / Collector" as ResourceOutputResolver <<control>> {
    +collectResourceOutputs(infrastructureReferences)
  }
  class "Workload Output Resolver" as WorkloadOutputResolver <<control>> {
    +resolvePlanTimeWorkloadOutputs(graph, context)
  }
  class "Environment Configuration Resolver" as ConfigResolver <<control>> {
    +resolveEnvironmentConfiguration(configuration, resourceOutputs, workloadOutputs)
  }
  class "Resolved Specification Generator" as SpecGenerator <<control>> {
    +generateResolvedApplicationSpecification(applicationDefinition, images, resolvedConfiguration)
  }
  class "Manifest Generator / Score Renderer" as ManifestGenerator <<control>> {
    +generateKubernetesManifest(resolvedSpecification)
  }
  class "Target Manifest Adapter" as TargetAdapter <<control>> {
    +adaptManifestForTarget(baseManifest, target)
  }
  class "Environment Configuration Materializer" as ConfigMaterializer <<control>> {
    +materializeEnvironmentConfiguration(manifest, variables)
  }
  class "Secret Materializer" as SecretMaterializer <<control>> {
    +materializeSecretConfiguration(manifest, secrets)
  }
}
package "Integration abstractions" {
  interface "Provisioner Adapter / Provisioner Interface" as Provisioner {
    +reconcile(finalPlan, idempotencyKey)
  }
  interface "CD Integration / CD Provider Interface" as CDIntegration {
    +publishDesiredDeploymentState(desiredState, deploymentId, idempotencyKey)
  }
}
package "Integration implementations" {
  class "Concrete CD Provider" as CDProvider <<control>> {
    +publish(desiredState, idempotencyKey)
  }
}
package "External systems" {
  class "Terraform/OpenTofu Runner" as IaCRunner <<boundary>>
  class "score-k8s" as ScoreK8s <<boundary>>
  class "CD System" as CDSystem <<boundary>>
}
package "Persistence" {
  class "Application Repository" as AppRepo <<entity>> { +findById(applicationId) }
  class "Environment Configuration Repository" as ConfigRepo <<entity>> {
    +findByApplicationAndEnvironment(applicationId, environment)
    +findById(environmentConfigurationId)
  }
  class "Resource Instance Repository" as ResourceRepo <<entity>> {
    +findReusableInstances(applicationId, environment, requirementIds, target, sharingPolicy)
    +saveResourceInstancesAndBindings(ownerConsumerScopeAndState)
    +loadResourceOutputs(infrastructureReferences)
  }
  class "Deployment Repository" as DeploymentRepo <<entity>> {
    +persistDeployment(..., fingerprint, algorithm, status)
    +findByIdWithPersistedInputs(deploymentId)
    +compareAndSetPlanFingerprint(...)
    +acceptConfirmationAndEnqueue(...)
    +markExecutionRunning(deploymentId, jobId)
    +recordDeploymentStep(stepName, status, detail)
    +saveDeploymentRecord(deploymentId, infrastructureReferences, deliveryReference, deliveryStatus, lifecycleStatus)
  }
  class "Deployment Execution Job / Outbox" as JobStore <<entity>> {
    +claimNextJob(lease)
    +completeJob(jobId)
    +retryOrFail(jobId, error)
  }
}

WebUI --> API
API --> Orchestrator
Orchestrator --> AppRepo
Orchestrator --> ConfigRepo
Orchestrator --> GraphBuilder
Orchestrator --> ResourceResolver
Orchestrator --> Planner
Planner --> InfrastructurePlan
InfrastructurePlan *-- InfrastructurePlanItem
InfrastructurePlanItem *-- OverrideDefinition
Orchestrator --> ResourceRepo
Orchestrator --> DeploymentRepo
DeploymentRepo --> JobStore : same DB transaction
Worker --> JobStore
Worker --> DeploymentRepo
Worker --> Planner
Worker --> Reconciler
Worker --> ResourceOutputResolver
Worker --> WorkloadOutputResolver
Worker --> ConfigResolver
Worker --> SpecGenerator
Worker --> ManifestGenerator
Worker --> TargetAdapter
Worker --> ConfigMaterializer
Worker --> SecretMaterializer
Worker --> CDIntegration
Reconciler --> Provisioner
Reconciler --> ResourceRepo
Provisioner ..> IaCRunner
ManifestGenerator ..> ScoreK8s
CDIntegration ..> CDSystem
CDIntegration <|.. CDProvider
CDProvider ..> CDSystem

note right of JobStore
  Durable job is the transactional outbox.
  Unique deployment/idempotency keys, leases and attempts make retries safe.
end note
@enduml
