@startuml
title Step 1 - VOPC / Consolidated Design Class Diagram

left to right direction
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
hide empty members

package "Boundary/UI" {
  class "Web UI" as WebUI <<boundary>> {
    -currentApplicationId: String
    -selectedEnvironment: String
    -selectedTarget: String
    -selectedCatalogVersion: String
    -selectedImages: Map
    -selectedDeploymentId: String
    +showApplicationEditor()
    +showApplicationOverview()
    +showConfigurationRequirements()
    +showValidResourceOutputs()
    +showValidWorkloadOutputs()
    +showDeploymentForm()
    +showInfrastructurePlan()
    +showDeploymentTracking()
    +showDeploymentHistory()
    +showDeploymentResult()
  }
  class "Application API / Controller" as ApplicationAPI <<control>> {
    -applicationService: ApplicationService
    +createApplication(name, description)
    +updateApplication(applicationId)
    +addResourceRequirement(applicationId, resources)
    +addWorkload(applicationId, workloads)
    +defineConfigurationRequirement(applicationId, requirements)
    +defineDependency(applicationId, dependencies)
    +saveApplicationDefinition(applicationDefinition)
  }
  class "Environment Configuration API / Controller" as EnvironmentAPI <<control>> {
    -configurationService: EnvironmentConfigurationService
    +selectEnvironment(applicationId, environment)
    +setDirectConfigurationValue(item, value)
    +requestResourceOutputs(resource)
    +requestWorkloadOutputs(workload)
    +bindResourceOutput(item, resource, output)
    +bindWorkloadOutput(variable, workload, output)
    +saveEnvironmentConfiguration(configuration)
  }
  class "Deployment API / Controller" as DeploymentAPI <<control>> {
    -orchestrator: DeploymentOrchestrator
    +loadDeploymentForm(applicationId, environment, target)
    +createDeployment(applicationId, version, catalogVersion, environment, target, images, context)
    +confirmDeployment(deploymentId, overrides)
  }
  class "Deployment Query API / Controller" as DeploymentQueryAPI <<control>> {
    -queryService: DeploymentQueryService
    +listDeployments(applicationId)
    +getDeploymentDetail(deploymentId)
    +getDeploymentFailureDetail(deploymentId)
  }
}

package "Application services" {
  class "Application Service" as ApplicationService <<control>> {
    -applicationRepository: ApplicationRepository
    -specificationRepository: SpecificationRepository
    +createApplication(name, description)
    +updateApplication(applicationId)
    +addResourceRequirement(applicationId, resources)
    +addWorkload(applicationId, workloads)
    +defineConfigurationRequirement(applicationId, requirements)
    +defineDependency(applicationId, dependencies)
    +saveApplicationDefinition(applicationDefinition)
  }
  class "Environment Configuration Service" as EnvironmentConfigurationService <<control>> {
    -applicationQuery: ApplicationQueryRepository
    -configurationRepository: EnvironmentConfigurationRepository
    +selectEnvironment(applicationId, environment)
    +setDirectConfigurationValue(item, value)
    +requestResourceOutputs(resource)
    +requestWorkloadOutputs(workload)
    +bindResourceOutput(item, resource, output)
    +bindWorkloadOutput(variable, workload, output)
    +saveEnvironmentConfiguration(configuration)
  }
  class "Deployment Orchestrator" as DeploymentOrchestrator <<control>> {
    -deploymentId: String
    -deploymentContext: Object
    +loadDeploymentContext(applicationId, environment, target)
    +createDeployment(applicationId, version, catalogVersion, environment, target, images, context)
    +validateDeploymentInput()
    +computePlanFingerprint(plan, allowedOverrides, algo)
    +confirmDeployment(deploymentId, overrides)
  }
  class "Deployment Worker" as DeploymentWorker <<control>> {
    -currentJob: DeploymentExecutionJob
    -finalPlan: Object
  }
  class "Deployment Query Service" as DeploymentQueryService <<control>> {
    -deploymentRepository: DeploymentRepository
    -resourceRepository: ResourceInstanceRepository
    -workloadInstanceRepository: WorkloadInstanceRepository
    +listDeployments(applicationId)
    +getDeploymentDetail(deploymentId)
    +getDeploymentFailureDetail(deploymentId)
  }
}

package "Domain components" {
  class "Application Definition Validator" as ApplicationDefinitionValidator <<control>> {
    -validationRules: List
    +validateApplicationDefinition(applicationDefinition)
  }
  class "Application Specification Generator" as ApplicationSpecificationGenerator <<control>> {
    -specificationFormat: String
    +generateApplicationSpecification(applicationDefinitionVersion)
  }
  class "Resource Output Catalog / Resource Definition Query" as ResourceOutputCatalog <<control>> {
    -resourceDefinitions: List
    +listValidOutputs(resource)
    +listValidSensitiveOutputs(resource)
  }
  class "Workload Output Catalog" as WorkloadOutputCatalog <<control>> {
    -workloadDefinitions: List
    +listValidOutputs(workload)
  }
  class "Environment Configuration Validator" as EnvironmentConfigurationValidator <<control>> {
    -validationRules: List
    +validateEnvironmentConfiguration(configuration)
  }
  class "Deployment Graph Builder" as DeploymentGraphBuilder <<control>> {
    -graph: Object
    +buildDeploymentGraph(applicationDefinitionVersion, configuration, images, catalogVersion, context)
  }
  class "Deployment Wave Planner" as DeploymentWavePlanner <<control>> {
    -waves: List
    +planDeploymentWaves(graph, selectedWorkloads, runningWorkloadInstances)
    +findPotentialRedeploys(graph, waves, plan, runningWorkloadInstances)
    +propagateOutputChanges(waves, waveComponents, collectedOutputs)
  }
  class "Resource Definition Resolver" as ResourceDefinitionResolver <<control>> {
    -resolvedDefinitions: List
    +resolveResourceDefinitions(requirements, catalogVersion, context)
  }
  class "Infrastructure Planner" as InfrastructurePlanner <<control>> {
    -plan: Object
    -allowedOverrides: Map
    +planInfrastructureChanges(graph, waves, resolvedDefinitions, currentInstances, runningWorkloadInstances)
    +loadInfrastructureOverrides(plan)
    +applyInfrastructureOverrides(plan, overrides)
  }
  class "Infrastructure Reconciler" as InfrastructureReconciler <<control>> {
    -infrastructureReferences: List
    +reconcileInfrastructure(finalPlan, planItems, requiredResourceOutputs)
  }
  class "Resource Output Resolver / Collector" as ResourceOutputCollector <<control>> {
    -resourceOutputs: Map
    +collectResourceOutputs(infrastructureReferences)
  }
  class "Environment Configuration Resolver" as EnvironmentConfigurationResolver <<control>> {
    -resolvedConfiguration: Map
    +resolveEnvironmentConfiguration(configuration, waveWorkloads, resourceOutputs, workloadOutputs)
  }
  class "Workload Output Collector" as WorkloadOutputCollector <<control>> {
    -workloadOutputs: Map
    +collectWorkloadOutputs(target, workloads)
  }
  class "Resolved Specification Generator" as ResolvedSpecificationGenerator <<control>> {
    -resolvedSpecification: Object
    +generateResolvedApplicationSpecification(applicationDefinitionVersion, images, resolvedConfiguration)
  }
  class "Manifest Generator / Score Renderer" as ManifestGenerator <<control>> {
    -baseManifest: Object
    +generateKubernetesManifest(resolvedSpecification)
  }
  class "Target Manifest Adapter" as TargetManifestAdapter <<control>> {
    -target: String
    +adaptManifestForTarget(baseManifest, target)
  }
  class "Environment Configuration Materializer" as EnvironmentConfigurationMaterializer <<control>> {
    -resolvedEnvironmentVariables: Map
    +materializeEnvironmentConfiguration(targetAdaptedManifest, resolvedEnvironmentVariables)
  }
  class "Secret Materializer" as SecretMaterializer <<control>> {
    -resolvedSecrets: Map
    +materializeSecretConfiguration(manifest, resolvedSecrets)
  }
  class "Deployment Result Aggregator" as DeploymentResultAggregator <<control>> {
    -viewModel: Object
    +aggregate(deploymentRecord, version, progress, images, workloadInstances, infrastructureStatus, cdStatus, workloadStatus, endpoints)
  }
}

package "Integration abstractions" {
  interface "Secret Store / Secret Management Adapter" as SecretStore <<interface>> {
    -secretNamespace: String
    +storeSecret(applicationId, environment, secretValue)
  }
  interface "Provisioner Adapter / Provisioner Interface" as ProvisionerAdapter <<interface>> {
    -provisioningContext: Object
    +reconcile(planItems, requiredResourceOutputs)
    +destroy(planItems)
  }
  interface "CD Integration / CD Provider Interface" as CDIntegration <<interface>> {
    -deliveryReference: String
    +publishDesiredDeploymentState(desiredState)
  }
  interface "Delivery Repository Provider" as RepoProvider <<interface>> {
    -namingPattern: String
    +ensureDeliveryRepository(application)
  }
  interface "CD Integration / CD Status Provider" as CDStatusProvider <<interface>> {
    -deliveryReference: String
    +getCDStatus(deliveryReference)
  }
  interface "Workload Status Provider / Kubernetes Adapter" as WorkloadStatusProvider <<interface>> {
    -target: String
    +getWorkloadStatus(target, workloads)
    +getDeploymentEndpoints(target, workloads)
    +waitForWorkloadsHealthy(target, workloads)
    +readWorkloadOutputs(target, workloads)
  }
}

package "Integration implementations" {
  class "Concrete CD Provider" as ConcreteCDProvider <<control>> {
    -providerType: String
    -endpoint: String
    +publish(desiredState)
    +getStatus(deliveryReference)
  }
  class "Concrete Git Hosting Provider" as GitHosting <<control>> {
    -hostingType: String
    -credentialReference: String
    +createRepository(name)
    +attachKeyPair(repository, writeKey, readKey)
  }
}

package "External systems" {
  class "Terraform/OpenTofu Runner" as IaCRunner <<boundary>> {
    -moduleSource: String
    -workspace: String
    +applyInfrastructureModules(planItems)
    +destroyInfrastructureModules(planItems)
  }
  class "score-k8s" as ScoreK8s <<boundary>> {
    -rendererVersion: String
    +render(resolvedSpecification)
  }
  class "CD System" as CDSystem <<boundary>> {
    -systemType: String
    -endpoint: String
    +synchronize(desiredState)
    +queryDeploymentStatus(deliveryReference)
  }
  class "Kubernetes Cluster" as KubernetesCluster <<boundary>> {
    -clusterId: String
    -apiEndpoint: String
    +deployWorkloadsAndConfiguration(desiredState)
    +queryWorkloadHealthAndEndpoints(target, workloads)
    +queryExposedEndpoints(target, workloads)
    +watchPodHealth(target, workloads)
    +readWorkloadRuntimeData(target, workloads)
  }
}

package "Persistence" {
  class "Application Repository" as ApplicationRepository <<entity>> {
    -applicationDefinitionVersions: Collection
    +findLatestVersion(applicationId)
    +saveNewVersion(applicationDefinition)
    +listVersions(applicationId)
    +findVersion(applicationId, version)
    +ensurePlatformRequirements(applicationId, platformRequirements)
  }
  class "Specification Repository / Config Repo Service" as SpecificationRepository <<entity>> {
    -applicationSpecifications: Collection
    +save(applicationSpecification)
  }
  class "Application Query / Application Repository" as ApplicationQueryRepository <<entity>> {
    -applicationDefinitions: Collection
    +loadConfigurationRequirements(applicationId)
  }
  class "Environment Configuration Repository" as EnvironmentConfigurationRepository <<entity>> {
    -environmentConfigurations: Collection
    +save(configurationWithValueReferences)
    +findByApplicationAndEnvironment(applicationId, environment)
    +findById(environmentConfigurationId)
  }
  class "Delivery Repository Registry" as DeliveryRepositoryRegistry <<entity>> {
    -deliveryRepositories: Collection
    +findDeliveryRepository(applicationId)
    +saveDeliveryRepository(applicationId, url, branch, keyReferences)
  }
  class "Resource Definition Catalog" as ResourceDefinitionCatalog <<entity>> {
    -catalogVersions: Collection
    +listCatalogVersions()
    +findResourceDefinitions(catalogVersion)
  }
  class "Resource Instance Repository" as ResourceInstanceRepository <<entity>> {
    -resourceInstances: Collection
    +findResourceInstances(applicationId, environment, requirementIds, target)
    +saveResourceInstances(resourceState)
    +loadResourceOutputs(infrastructureReferences)
    +loadOutputFingerprints(resources)
    +updateOutputFingerprints(resources)
    +getInfrastructureStatus(infrastructureReferences)
  }
  class "Workload Instance Repository" as WorkloadInstanceRepository <<entity>> {
    -workloadInstances: Collection
    +findWorkloadInstances(applicationId, environment, target)
    +saveWorkloadInstances(workloads, status)
    +updateWorkloadInstances(workloads, status, outputFingerprints)
    +loadOutputFingerprintsAndRunningImages(workloads, dependents)
  }
  class "Deployment Repository" as DeploymentRepository <<entity>> {
    -deploymentRecords: Collection
    -executionJobs: Collection
    +persistDeployment(deployment, applicationDefinitionVersion, catalogVersion, workloadDeployments, deploymentContext, planFingerprint, planFingerprintAlgo, status)
    +findByIdWithPersistedInputs(deploymentId)
    +compareAndSetPlanFingerprint(deploymentId, expectedStatus, expectedFingerprint, newFingerprint)
    +confirmDeploymentAndCreateJob(deploymentId, expectedStatus, overrides)
    +claimNextExecutionJob()
    +updateDeploymentStatus(deploymentId, expectedStatus, newStatus)
    +saveDeploymentRecord(deployment, workloadImages, infrastructureReferences, deliveryReferences, removedComponents)
    +findByApplication(applicationId)
    +getDeploymentDetail(deploymentId)
    +getDeploymentFailureDetail(deploymentId)
    +getDeploymentProgress(deploymentId)
    +getDeploymentImages(deploymentId)
  }
}

WebUI "1" --> "1" ApplicationAPI : UC-01
WebUI "1" --> "1" EnvironmentAPI : UC-02
WebUI "1" --> "1" DeploymentAPI : UC-03
WebUI "1" --> "1" DeploymentQueryAPI : UC-04

ApplicationAPI "1" --> "1" ApplicationService
ApplicationService ..> ApplicationDefinitionValidator
ApplicationService "1" --> "1" ApplicationRepository
ApplicationService ..> ApplicationSpecificationGenerator
ApplicationService "1" --> "1" SpecificationRepository

EnvironmentAPI "1" --> "1" EnvironmentConfigurationService
EnvironmentConfigurationService "1" --> "1" ApplicationQueryRepository
EnvironmentConfigurationService ..> ResourceOutputCatalog
EnvironmentConfigurationService ..> WorkloadOutputCatalog
EnvironmentConfigurationService ..> EnvironmentConfigurationValidator
EnvironmentConfigurationService ..> SecretStore
EnvironmentConfigurationService "1" --> "1" EnvironmentConfigurationRepository

DeploymentAPI "1" --> "1" DeploymentOrchestrator
DeploymentOrchestrator "1" --> "1" ApplicationRepository
DeploymentOrchestrator "1" --> "1" EnvironmentConfigurationRepository
DeploymentOrchestrator "1" --> "1" ResourceDefinitionCatalog
DeploymentOrchestrator ..> DeploymentGraphBuilder
DeploymentOrchestrator ..> DeploymentWavePlanner
DeploymentOrchestrator ..> InfrastructurePlanner
DeploymentOrchestrator "1" --> "1" ResourceInstanceRepository
DeploymentOrchestrator "1" --> "1" WorkloadInstanceRepository
DeploymentOrchestrator "1" --> "1" DeploymentRepository

DeploymentWorker "1" --> "1" DeploymentRepository
DeploymentWorker "1" --> "1" ApplicationRepository
DeploymentWorker "1" --> "1" EnvironmentConfigurationRepository
DeploymentWorker ..> DeploymentGraphBuilder
DeploymentWorker ..> DeploymentWavePlanner
DeploymentWorker ..> InfrastructurePlanner
DeploymentWorker ..> InfrastructureReconciler
DeploymentWorker ..> ResourceOutputCollector
DeploymentWorker ..> WorkloadOutputCollector
DeploymentWorker ..> EnvironmentConfigurationResolver
DeploymentWorker ..> ResolvedSpecificationGenerator
DeploymentWorker ..> ManifestGenerator
DeploymentWorker ..> TargetManifestAdapter
DeploymentWorker ..> EnvironmentConfigurationMaterializer
DeploymentWorker ..> SecretMaterializer
DeploymentWorker ..> CDIntegration
DeploymentWorker ..> WorkloadStatusProvider
DeploymentWorker "1" --> "1" ResourceInstanceRepository
DeploymentWorker "1" --> "1" WorkloadInstanceRepository

DeploymentGraphBuilder ..> ResourceDefinitionResolver
ResourceDefinitionResolver "1" --> "1" ResourceDefinitionCatalog
DeploymentWavePlanner "1" --> "1" ResourceInstanceRepository
DeploymentWavePlanner "1" --> "1" WorkloadInstanceRepository
InfrastructureReconciler ..> ProvisionerAdapter
InfrastructureReconciler "1" --> "1" ResourceInstanceRepository
ResourceOutputCollector "1" --> "1" ResourceInstanceRepository
WorkloadOutputCollector ..> WorkloadStatusProvider
ManifestGenerator ..> ScoreK8s
CDIntegration <|.. ConcreteCDProvider
CDIntegration ..> RepoProvider
CDIntegration "1" --> "1" DeliveryRepositoryRegistry
RepoProvider <|.. GitHosting
ProvisionerAdapter ..> IaCRunner : reconcile()/destroy() delegate apply/destroyInfrastructureModules()
ConcreteCDProvider ..> CDSystem
CDSystem ..> KubernetesCluster

DeploymentQueryAPI "1" --> "1" DeploymentQueryService
DeploymentQueryService "1" --> "1" DeploymentRepository
DeploymentQueryService "1" --> "1" ResourceInstanceRepository
DeploymentQueryService "1" --> "1" WorkloadInstanceRepository
DeploymentQueryService ..> CDStatusProvider
DeploymentQueryService ..> WorkloadStatusProvider
DeploymentQueryService ..> DeploymentResultAggregator
CDStatusProvider <|.. ConcreteCDProvider
WorkloadStatusProvider ..> KubernetesCluster

note right of SecretStore
  Concrete secret backend is not selected
  in the source realization.
end note

note right of WorkloadStatusProvider
  The source names the abstraction and
  Kubernetes adapter as one participant.
end note

note right of DeploymentWorker
  Active background process: claims execution jobs
  from Deployment Repository and receives no inbound
  message, so it owns no operation. Recovery when a
  worker dies mid-job is deferred (D6).
end note

note right of ApplicationRepository
  Application Definition versions are immutable;
  components keep stable IDs across versions.
end note

note right of KubernetesCluster
  On a cloud target the cluster is provisioned by IDP
  (k8s-cluster resolves to a MANAGED definition); an
  internal cluster already exists (EXISTING definition).
  Connection data comes from the k8s-cluster Resource Output.
end note

note right of ResourceDefinitionCatalog
  Catalog versions are immutable and managed by the
  platform; IDP only reads them.
end note

@enduml
