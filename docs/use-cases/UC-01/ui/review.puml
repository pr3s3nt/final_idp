@startuml
title UC-01 desktop web — Workspace Review chỉ đọc

skinparam backgroundColor #F3F5F8
skinparam shadowing false
skinparam roundcorner 8
skinparam rectangle {
  BackgroundColor #FFFFFF
  BorderColor #D8DEE8
  FontColor #182230
}

rectangle "Route React web\n/ui/applications/{applicationId}" as Browser {
  rectangle "Vùng header\n← Applications  |  shop-app  |  Version 2 · Unsaved  |  Discard  |  Save application" as Header

  rectangle "Điều hướng Application Builder\n\nOverview\n● backend       1 lỗi\n○ frontend      1 lỗi\n◆ postgresql\n\nReview          2 lỗi" as Navigation

  rectangle "Review application" as Review {
    rectangle "Validation summary\n2 problems must be fixed before saving\nMỗi lỗi điều hướng về đúng workspace và field sở hữu" as Validation
    rectangle "Topology · Read only\n\nfrontend ──depends on──▶ backend\n                            │\n                            └──depends on──▶ postgresql\n\nMọi quan hệ cũng được biểu diễn bằng text" as Topology
    rectangle "Component summary\n2 workloads · 1 resource · 2 dependencies\nbackend · 1 output · 1 variable · 1 secret" as Summary

    Validation -[hidden]down- Topology
    Topology -[hidden]down- Summary
  }

  Header -[hidden]down- Navigation
  Navigation -[hidden]right- Review
}

note right of Review
  Review không bao giờ thay đổi draft.
  Topology dùng để kiểm tra, không phải
  bề mặt chỉnh sửa kéo-thả.
end note

@enduml
